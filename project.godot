[internationalization]

locale/translations=PackedStringArray("res://assets/i18n/ui.vi.translation", "res://assets/i18n/ui.en.translation")
locale/fallback="vi"

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="party"
2d_physics/layer_3="enemy"
2d_physics/layer_4="party_hurtbox"
2d_physics/layer_5="enemy_hurtbox"
2d_physics/layer_6="interactable"
2d_physics/layer_7="pickup"
2d_physics/layer_8="neutral_hurtbox"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
environment/defaults/default_clear_color=Color(0.08, 0.09, 0.1, 1)
